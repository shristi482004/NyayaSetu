# ==============================================================================
# NyayaSetu Unified Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application via Docker Compose:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit actual .env files containing production secrets to version control.
# - In production, generate cryptographically random strings for all secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node.js Backend Gateway Configuration (src/backend)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Inside Docker network, use mongodb://mongodb:27017/nyayasetu)
MONGODB_URI=mongodb://mongodb:27017/nyayasetu

# Secret key used to sign and verify JWT authentication tokens (min 32 characters)
JWT_SECRET=replace_with_a_secure_cryptographic_jwt_secret_key_32_chars_min

# CORS Allowed Origins (Comma-separated list of allowed web origins)
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Python AI & ML Microservice Configuration (src/ai_service)
# ------------------------------------------------------------------------------
AI_PORT=8000
AI_SERVICE_URL=http://ai-service:8000

# Shared internal API key used to authenticate Backend <-> AI Service communication
AI_INTERNAL_API_KEY=replace_with_a_strong_shared_internal_service_secret_key

# Google Gemini API Key for LLM document synthesis and grounded chat
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Official supported models: gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.0-flash

# Mock Mode Toggle (Set to 'true' for offline automated testing without incurring API costs)
MOCK_GEMINI_IN_DEV=false

# OCR Character Density Threshold (Pages with fewer characters trigger Tesseract 200 DPI OCR)
OCR_MIN_CHAR_THRESHOLD=50

# ------------------------------------------------------------------------------
# 3. React Frontend Client Configuration (src/frontend)
# ------------------------------------------------------------------------------
# In production (served via Nginx reverse proxy), API requests are forwarded via /api
VITE_API_BASE_URL=/api
